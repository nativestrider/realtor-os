# RealtorOS install channels — edit on main; bump stable via scripts/bump-version.sh
#
# Channels:
#   stable  — latest semver tag (recommended for end users)
#   beta    — pre-release branch (beta testers)
#   dev     — main branch (developers; this repo)

REALTOR_CHANNEL_DEFAULT=stable

REALTOR_CHANNEL_STABLE_REF=v0.1.0
REALTOR_CHANNEL_STABLE_VERSION=0.1.0

REALTOR_CHANNEL_BETA_REF=beta
REALTOR_CHANNEL_BETA_VERSION=beta

REALTOR_CHANNEL_DEV_REF=main
REALTOR_CHANNEL_DEV_VERSION=dev
